{/*
This is the action template.
It determines how the formatting actions are rendered.
*/}

{{define "section"}}
  <h{{len .Number}} id="TOC_{{.FormattedNumber}}">{{.FormattedNumber}} {{.Title}}</h{{len .Number}}>
  {{range .Elem}}{{elem $.Template .}}{{end}}
{{end}}

{{define "text"}}
  <p>
    {{range $i, $l := .Lines}}{{if $i}}{{template "newline"}}
    {{end}}{{$l}}{{end}}
  </p>
{{end}}

{{define "code"}}
  <div class="code{{if playable .}} playground{{end}}" {{if .Edit}}contenteditable="true" spellcheck="false"{{end}}>{{.Text}}</div>
{{end}}

{{define "image"}}
<div class="image" style="
  {{- with .WidthFrac}}--image-width-frac: {{.}}; {{end}}
  {{- with .HeightFrac}}--image-height-frac: {{.}}; {{end}}
  {{- with .Width}}--image-width: {{.}}; {{end}}
  {{- with .Height}}--image-height: {{.}}; {{end}}">
  {{- if not .Missing}}
  <img src="{{.URL}}"{{with .Height}} height="{{.}}"{{end}}{{with .Width}} width="{{.}}"{{end}}>
  {{- end}}
  {{- with .Error}}
  <div class="image-error{{if not $.Missing}} stale no-print{{end}}">{{.}}</div>
  {{- end}}
</div>
{{end}}

{{define "video"}}
<div class="video">
  <video {{with .Height}} height="{{.}}"{{end}}{{with .Width}} width="{{.}}"{{end}} controls>
    <source src="{{.URL}}" type="{{.SourceType}}">
  </video>
</div>
{{end}}

{{define "iframe"}}
<iframe src="{{.URL}}"{{with .Height}} height="{{.}}"{{end}}{{with .Width}} width="{{.}}"{{end}}></iframe>
{{end}}

{{define "link"}}<p class="link"><a href="{{.URL}}" target="_blank">{{markdown .Label}}</a></p>{{end}}

{{define "html"}}{{.HTML}}{{end}}

{{define "caption"}}<figcaption>{{markdown .Text}}</figcaption>{{end}}
