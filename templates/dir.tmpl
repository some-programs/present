<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <title>{{with .Path}}{{.}} - {{end}}present</title>
  <link type="text/css" rel="stylesheet" href="{{static "/static/dir.css"}}">
</head>
<body>

<div id="topbar"><div class="container">
<div id="heading"><a href="/">present</a></div>
</div></div>

<div id="page">

  <h1>Talks</h1>

  {{with .Path}}<h2>{{.}}</h2>{{end}}

  {{if and .Doc (not .Path)}}
  <h4>Documentation:</h4>
  <dl>
  <dd><a href="/_doc">README</a>: how to write presentations and run present</dd>
  <dd><a href="/_examples">Examples</a>: presentations that show every feature; press S on a slide to see its source</dd>
  </dl>
  {{end}}

  {{with .Articles}}
  <h4>Articles:</h4>
  <dl>
  {{range .}}
  <dd><a href="/{{.Path}}">{{.Name}}</a>: {{.Title}}</dd>
  {{end}}
  </dl>
  {{end}}

  {{with .Slides}}
  <h4>Slide decks:</h4>
  <dl>
  {{range .}}
  <dd><a href="/{{.Path}}">{{.Name}}</a>: {{.Title}}</dd>
  {{end}}
  </dl>
  {{end}}

  {{with .Other}}
  <h4>Files:</h4>
  <dl>
  {{range .}}
  <dd><a href="/{{.Path}}">{{.Name}}</a></dd>
  {{end}}
  </dl>
  {{end}}

  {{with .Dirs}}
  <h4>Sub-directories:</h4>
  <dl>
  {{range .}}
  <dd><a href="/{{.Path}}">{{.Name}}</a></dd>
  {{end}}
  </dl>
  {{end}}

  {{if and .Doc (not .Path)}}
  <h4>Fonts:</h4>
  <dl>
  <dd><a href="/download/fonts.tar">fonts.tar</a>: Roboto and JetBrains Mono, for diagrams to match the slides</dd>
  </dl>
  {{end}}

</div>

</body>
</html>
