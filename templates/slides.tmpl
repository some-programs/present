{/* This is the slide template. It defines how presentations are formatted. */}

{{define "root"}}
<!DOCTYPE html>
<html>
  <head>
    <title>{{.Title}}</title>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width,height=device-height,initial-scale=1'>
    <meta name='apple-mobile-web-app-capable' content='yes'>
    <link rel='preload' href='/static/fonts/roboto-normal-latin.woff2' as='font' type='font/woff2' crossorigin>
    <link rel='preload' href='/static/fonts/robotomono-normal-latin.woff2' as='font' type='font/woff2' crossorigin>
    <link rel='stylesheet' href='/static/fonts.css'>
    <link rel='stylesheet' href='/static/styles.css'>
    <script>
      var notesEnabled = {{.NotesEnabled}};
    </script>
    {{if hot}}
    <script type='module' src='/static/js/hot.js'></script>
    {{end}}
    <script type='module' src='/static/js/slides.js'></script>

    {{if .NotesEnabled}}
    <script>
      var sections = {{.Sections}};
      var titleNotes = {{.TitleNotes}}
    </script>
    {{end}}
  </head>

  <body>

    <section class='slides layout-widescreen'>

      <article>
        <h1>{{.Title}}</h1>
        {{with .Subtitle}}<h3>{{.}}</h3>{{end}}
        {{if not .Time.IsZero}}<h3>{{.Time.Format "2 January 2006"}}</h3>{{end}}
        {{range .Authors}}
          <div class="presenter">
            {{range .TextElem}}{{elem $.Template .}}{{end}}
          </div>
        {{end}}
      </article>

  {{range $i, $s := .Sections}}
  <!-- start of slide {{$s.Number}} -->
      <article {{$s.HTMLAttributes}}>
      {{if $s.Elem}}
        <h3>{{$s.Title}}</h3>
        {{elems $.Template $s.Elem}}
      {{else}}
        <h2>{{$s.Title}}</h2>
      {{end}}
      <span class="pagenumber no-print">{{pagenum $s 1}}</span>
      </article>
  <!-- end of slide {{$s.Number}} -->
  {{end}}{{/* of Slide block */}}

  {{if thankYou}}
      <article>
        <h3>Thank you</h3>
        {{range .Authors}}
          <div class="presenter">
            {{range .Elem}}{{elem $.Template .}}{{end}}
          </div>
        {{end}}
      </article>
  {{end}}

    </section>

    <div id="help">
      Use the left and right arrow keys or click the left and right
      edges of the page to navigate between slides.<br>
      (Press 'H' or navigate to hide this message.)
    </div>

    {{if .PlayEnabled}}
    <script type='module' src='/static/js/play.js'></script>
    {{end}}
  </body>
</html>
{{end}}

{{define "newline"}}
<br>
{{end}}

{{/* Subsections of a slide get a small heading, without a number. */}}
{{define "section"}}
  <h4>{{.Title}}</h4>
  {{elems $.Template .Elem}}
{{end}}
