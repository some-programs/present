{/* This is the slide template. It defines how presentations are formatted. */}

{{define "root"}}
<!DOCTYPE html>
<html>
  <head>
    <title>{{.Title}}</title>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width,height=device-height,initial-scale=1'>
    <meta name='apple-mobile-web-app-capable' content='yes'>
    {{if not .InlineFonts}}
    <link rel='preload' href='{{static "/static/fonts/roboto-normal-latin.woff2"}}' as='font' type='font/woff2' crossorigin>
    <link rel='preload' href='{{static "/static/fonts/jetbrainsmono-normal-latin.woff2"}}' as='font' type='font/woff2' crossorigin>
    {{end}}
    <link rel='stylesheet' href='{{static "/static/fonts.css"}}'>
    <link rel='stylesheet' href='{{static "/static/styles.css"}}'>
    <script>
      var notesEnabled = {{.NotesEnabled}};
      var preloadEnabled = {{.PreloadEnabled}};
    </script>
    {{if hot}}
    <script defer src='{{static "/static/js/hot.js"}}'></script>
    {{end}}
    <script defer src='{{static "/static/js/notes.js"}}'></script>
    <script defer src='{{static "/static/js/source.js"}}'></script>
    <script defer src='{{static "/static/js/slides.js"}}'></script>
  </head>

  <body>

    <section class='slides layout-widescreen'>

      <article>
        <h1>{{.Title}}</h1>
        {{with .Subtitle}}<h3>{{.}}</h3>{{end}}
        {{if not .Time.IsZero}}<h3>{{.Time.Format "2 January 2006"}}</h3>{{end}}
        {{range .Authors}}
          <div class="presenter">
            {{range .TextElem}}{{elem $.Template .}}{{end}}
          </div>
        {{end}}
      </article>

  {{range $i, $s := .Sections}}
  <!-- start of slide {{$s.Number}} -->
      <article {{$s.HTMLAttributes}}>
      {{if $s.Elem}}
        <h3>{{$s.Title}}</h3>
        {{elems $.Template $s.Elem}}
      {{else}}
        <h2>{{$s.Title}}</h2>
      {{end}}
      <span class="pagenumber no-print">{{pagenum $s 1}}</span>
      </article>
  <!-- end of slide {{$s.Number}} -->
  {{end}}{{/* of Slide block */}}

  {{if thankYou}}
      <article>
        <h3>Thank you</h3>
        {{range .Authors}}
          <div class="presenter">
            {{range .Elem}}{{elem $.Template .}}{{end}}
          </div>
        {{end}}
      </article>
  {{end}}

    </section>

    {{with .Sources}}
    <aside id="source" class="no-print">
      {{range .}}
      <div class="src-slide" hidden>
        <div class="src-title">Source of slide {{.Number}}<span>S or Esc closes</span></div>
        <div class="src-name">{{$.SourceFile}}</div>
        <pre class="src-markup">{{range .Lines}}<span class="{{.Class}}">{{.Text}}{{"\n"}}</span>{{end}}</pre>
        {{with .Files}}
        <h4>{{if eq (len .) 1}}File used{{else}}Files used{{end}}</h4>
        {{range .}}
        {{if .Text}}
        <details class="src-file" open>
          <summary><a href="{{.URL}}" target="_blank" rel="noopener">{{.Name}}</a></summary>
          <pre>{{.Text}}</pre>
        </details>
        {{else}}
        <div class="src-file"><a href="{{.URL}}" target="_blank" rel="noopener">{{.Name}}</a></div>
        {{end}}
        {{end}}
        {{end}}
      </div>
      {{end}}
      {{/* Shown for slides that present adds, such as with -thankyou. */}}
      <div class="src-slide" hidden>
        <div class="src-title">No source<span>S or Esc closes</span></div>
        <p>present adds this slide itself; it has no source.</p>
      </div>
    </aside>
    {{end}}

    <div id="help">
      Use the left and right arrow keys or click the left and right
      edges of the page to navigate between slides.<br>
      {{if .Sources}}Press 'S' to show or hide the source of the slide.<br>{{end}}
      (Press 'H' or navigate to hide this message.)
    </div>

    {{if .PlayEnabled}}
    <script defer src='{{static "/static/js/playground.js"}}'></script>
    <script defer src='{{static "/static/js/play.js"}}'></script>
    {{end}}
  </body>
</html>
{{end}}

{{define "notes"}}
<!DOCTYPE html>
<html>
  <head>
    <title>{{.Title}}</title>
    <meta charset='utf-8'>
    <link rel='stylesheet' href='{{static "/static/fonts.css"}}'>
    <link rel='stylesheet' href='{{static "/static/notes.css"}}'>
  </head>

  <body>
    <iframe id='presenter-slides'></iframe>
    <div id='presenter-notes'>
      {{/* The notes of each slide, of which notes.js shows the current
           slide's. The last is for slides that present adds, such as with
           -thankyou. */}}
      <div class='slide-notes' hidden>{{range .TitleNotes}}{{markdownBlock .}}{{end}}</div>
      {{range .Sections}}
      <div class='slide-notes' hidden>{{range sectionNotes .}}{{markdownBlock .}}{{end}}</div>
      {{end}}
      <div class='slide-notes' hidden></div>
    </div>
    <div id='timer'></div>
  </body>
</html>
{{end}}

{{define "newline"}}
<br>
{{end}}

{{/* Subsections of a slide get a small heading, without a number. */}}
{{define "section"}}
  <h4>{{.Title}}</h4>
  {{elems $.Template .Elem}}
{{end}}
